# FieldEdge Dashboard Credentials for Dispatch Automation
DASH_EMAIL=your_email@example.com
DASH_PASSWORD=your_password_here

# Scraper Rules Configuration
RULES_FILE_PATH=config/scraper_rules.json

# Backend API Configuration
BACKEND_API_URL=http://[IP_ADDRESS]/api/

# Dashboard API Login (JWT) - used for protected endpoints like /automation/dispatch-config/
BACKEND_API_EMAIL=your_dashboard_email@example.com
BACKEND_API_PASSWORD=your_dashboard_password
# Optional: login endpoint (default /auth/login)
# BACKEND_LOGIN_PATH=/auth/login
# Optional: provide a JWT directly instead of logging in
# BACKEND_API_TOKEN=

# Browser Configuration
HEADLESS=true
PORT=3000

# FieldEdge Board URLs
FIELDEDGE_LOGIN_URL=https://login.fieldedge.com/Account/Login
FIELDEDGE_BOARD_URL=https://login.fieldedge.com/#/DispatchBoard/

# Quo API (OpenPhone) Credentials & Settings
QUO_API_KEY=your_openphone_api_key_here
QUO_API_BASE_URL=https://api.openphone.com

# Tech Phone Line (Sender)
TECH_PHONE_NUMBER_ID=your_phone_number_id
TECH_PHONE_NUMBER=+12538801535

# Monitoring Daemon Configuration
POLL_INTERVAL_SECONDS=60

# Operating Hours Window (US Pacific Time - 7:00 AM to 8:00 PM)
OPERATING_START_HOUR_PST=7
OPERATING_END_HOUR_PST=20

# Dispatch Board Display Automation Sleep Hours (Pause during daytime: 7 AM - 8 PM PST)
DISPATCH_SLEEP_START_HOUR_PST=7
DISPATCH_SLEEP_END_HOUR_PST=20



